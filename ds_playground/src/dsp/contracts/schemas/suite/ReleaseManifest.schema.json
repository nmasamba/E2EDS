  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/tip/0.4.0/ReleaseManifest.schema.json",
  "title": "ReleaseManifest \u2014 proposed planning contract",
  "description": "Immutable packaged identity; lifecycle lives in the ledger. Planning examples are not usable releases. Draft 0.3.0 makes provider-neutral execution and independent serving explicit. Structural validity is not admission, qualification or approval. Draft 0.3.0 adds conversational/local-assistant and generated-code policy semantics where relevant.",
  "allOf": [
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "candidate_sha256": {
            "type": "string"
          },
          "artifacts": {
            "items": {
              "properties": {
                "sha256": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": "integer"
                },
                "evidence_status": {
                  "enum": [
                    "produced",
                    "verified"
                  ]
                }
              }
            }
          },
          "signatures": {
            "minItems": 1
          },
          "approval_refs": {
            "minItems": 1
          },
          "evaluation": {
            "properties": {
              "outcome": {
                "const": "PASS"
              },
              "evidence_grade": {
                "enum": [
                  "publisher_reported",
                  "platform_reproduced",
                  "independently_reviewed"
                ]
              },
              "report_ref": {
                "properties": {
                  "sha256": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "compatibility_profiles": {
            "contains": {
              "properties": {
                "status": {
                  "const": "tested"
                },
                "test_report_ref": {
                  "type": "object"
                }
              },
              "required": [
                "status",
                "test_report_ref"
              ]
            }
          },

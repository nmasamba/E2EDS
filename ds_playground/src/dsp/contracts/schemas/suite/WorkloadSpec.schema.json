            {
              "type": "null"
            }
          ]
        },
        "materiality": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "confirmation_status": {
          "enum": [
            "proposed",
            "confirmed",
            "rejected",
            "unknown"
          ]

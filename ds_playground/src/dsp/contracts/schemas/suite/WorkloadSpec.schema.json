  "$defs": {
    "IntentConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "row_id",
                  "entity_id",
                  "split_group",
                  "predictor",
                  "target"
                ]
              },
              "data_type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "nullable": {
                "type": "boolean"
              },
              "public_output": {
                "enum": [
                  "excluded",
                  "authorised_join_only",
                  "task_output"
                ]
              }
            },
            "required": [
              "field",
              "role",
              "data_type",
              "nullable",
              "public_output"
            ]
          },
          "minItems": 1
        },
        "split_group_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "excluded_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "count_basis": {
              "enum": [
                "source_fields",
                "transformed_features"
              ]
            },
            "hard_max_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "soft_objective": {
              "enum": [
                "none",
                "minimise_count_among_feasible"
              ]
            },
            "quality_policy": {
              "const": "frozen_evaluation_contract"
            }
          },
          "required": [
            "allowed_fields",
            "excluded_fields",
            "count_basis",
            "hard_max_count",
            "soft_objective",
            "quality_policy"
          ]
        },
        "output_transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "round_to_increment"
              },
              "output_field": {
                "type": "string",
                "minLength": 1
              },
              "increment": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "units": {
                "type": "string",
                "minLength": 1
              },
              "ties": {
                "enum": [
                  "away_from_zero",
                  "to_even"
                ]
              },
              "raw_value_public": {
                "const": false
              },
              "privacy_claim": {
                "const": "precision_only"
              }
            },
            "required": [
              "operation",
              "output_field",
              "increment",
              "units",
              "ties",
              "raw_value_public",
              "privacy_claim"
            ]
          },
          "minItems": 0
        },
        "privacy_status": {
          "enum": [
            "not_requested",
            "requires_review",
            "reviewed_with_evidence"
          ]
        }
      },
      "required": [
        "field_roles",
        "split_group_fields",
        "features",
        "output_transforms",
        "privacy_status"
      ]
    },
    "FieldProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^/"
        },
        "source_kind": {
          "enum": [
            "direct_user_message",
            "planning_example",
            "trusted_observation"
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_span": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1

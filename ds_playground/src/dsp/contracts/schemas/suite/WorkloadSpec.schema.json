        "confirmed_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field",
        "source_kind",
        "message_id",
        "source_span",
        "extraction_confidence",
        "materiality",
        "confirmation_status",
        "confirmed_by"
      ]
    }
  }

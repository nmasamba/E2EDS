{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.6.0"
    },
    "planning_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "const": "OutputBinding"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "proposed",
        "active",
        "revoked"
      ]
    },
    "mode": {
      "const": "filesystem"
    },
    "output_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "root_handle": {
      "type": "string",
      "minLength": 1
    },
    "relative_directory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
    },
    "conflict_policy": {
      "const": "new_version_or_fail"
    },
    "commit_policy": {
      "const": "same_filesystem_atomic_rename_or_unsupported"
    },
    "include_data": {
      "const": "only_with_export_rights"
    },
    "max_export_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "secret_refs_in_bundle": {
      "const": false
    },
    "start_endpoint": {
      "const": false
    },
    "authorisation_context_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "operator_ref": {
      "type": "string",
      "minLength": 1
    },
    "payer_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "planning_only",
    "id",
    "revision",
    "type",
    "tenant_ref",
    "project_ref",
    "owner_ref",
    "state",
    "mode",
    "output_ref",
    "root_handle",
    "relative_directory",
    "conflict_policy",
    "commit_policy",
    "include_data",
    "max_export_bytes",
    "secret_refs_in_bundle",
    "start_endpoint",
    "authorisation_context_ref",
    "receipt_ref",
    "operator_ref",
    "payer_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/tip/0.6.0/OutputBinding.schema.json",
  "title": "OutputBinding — proposed planning contract",
  "description": "Structural planning contract; no identity, rights, semantic, security, execution or performance guarantee.",
  "allOf": [
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "proposed"
          },
          "authorisation_context_ref": {
            "type": "null"
          },
          "receipt_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "authorisation_context_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "output_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "receipt_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}

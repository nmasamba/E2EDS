{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/dsp/0.1.0/ExportReceipt.schema.json",
  "title": "ExportReceipt \u2014 app-owned draft 0.1.0",
  "description": "Ledger record of one committed filesystem export (D23). The destination is machine-local and never enters a portable manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "id",
    "revision",
    "output_sha256",
    "destination",
    "version",
    "files",
    "result",
    "committed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "type": {
      "const": "ExportReceipt"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "result": {
      "enum": [
        "committed"
      ]
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

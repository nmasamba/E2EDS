{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsplayground.dev/schemas/app/0.1.0/Job.schema.json",
  "title": "Job — app-owned contract",
  "description": "A durable job and its live attempt. Every transition is a new revision and one ledger event; the fence advances on lease expiry, pause and cancel, and a result is committed only under the fence its attempt was leased with.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "time": { "type": "string", "format": "date-time" },
    "maybe_time": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "fence": { "type": "integer", "minimum": 0 }
  },
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "type": { "const": "Job" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "state": {
      "enum": ["queued", "running", "checkpointed", "pause_requested", "paused", "cancel_requested", "cancelled", "succeeded", "failed"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "enum": ["sleep", "hang", "crash_before_commit", "crash_after_commit", "fail_transient", "fail_final"] }
        },
        "seconds": { "type": "number", "minimum": 0, "maximum": 3600 }
      },
      "required": ["cues", "seconds"]
    },
    "submitted_at": { "$ref": "#/$defs/time" },
    "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
    "fence": { "$ref": "#/$defs/fence" },
    "failures": { "type": "integer", "minimum": 0, "maximum": 3 },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempt": { "$ref": "#/$defs/attempt" },
            "fence": { "$ref": "#/$defs/fence" },
            "worker": { "type": "string", "minLength": 1, "maxLength": 160 },
            "expires_at": { "$ref": "#/$defs/time" }
          },
          "required": ["attempt", "fence", "worker", "expires_at"]
        },
        { "type": "null" }
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempt": { "$ref": "#/$defs/attempt" },
            "sha256": { "$ref": "#/$defs/digest" },
            "at": { "$ref": "#/$defs/time" }
          },
          "required": ["attempt", "sha256", "at"]
        },
        { "type": "null" }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "minLength": 1, "maxLength": 160 },
            "sha256": { "$ref": "#/$defs/digest" },
            "attempt": { "$ref": "#/$defs/attempt" },
            "at": { "$ref": "#/$defs/time" }
          },
          "required": ["key", "sha256", "attempt", "at"]
        },
        { "type": "null" }
      ]
    },
    "charged_minor": { "type": "integer", "minimum": 0 },
    "acknowledged_at": { "$ref": "#/$defs/maybe_time" },
    "stopped_at": { "$ref": "#/$defs/maybe_time" },
    "reason": { "type": ["string", "null"], "maxLength": 200 }
  },
  "required": [
    "schema_version", "type", "id", "revision", "state", "task", "submitted_at", "attempts", "fence",
    "failures", "lease", "checkpoint", "result", "charged_minor", "acknowledged_at", "stopped_at", "reason"
  ]
}

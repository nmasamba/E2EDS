{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/dsp/0.1.0/PackManifest.schema.json",
  "title": "PackManifest \u2014 app-owned draft 0.1.0",
  "description": "Portable, deterministic listing of an exported pack: relative paths and digests only, no machine paths, timestamps or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "kind",
    "recipe",
    "source",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "type": {
      "const": "PackManifest"
    },
    "kind": {
      "enum": [
        "profile_pack"
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "execution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "execution": {
          "enum": [
            "signed_recipe"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]+$"
          },
          "role": {
            "enum": [
              "profile",
              "report"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}

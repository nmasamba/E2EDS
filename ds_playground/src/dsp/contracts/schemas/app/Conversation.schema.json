{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsplayground.dev/schemas/app/0.1.0/Conversation.schema.json",
  "title": "Conversation — app-owned contract",
  "description": "One conversation about one workload. Its commands and events are the ledger's; this record is what they reference.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "type": { "const": "Conversation" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "project_ref": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workload_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["schema_version", "type", "id", "revision", "project_ref", "workload_id", "created_at"]
}

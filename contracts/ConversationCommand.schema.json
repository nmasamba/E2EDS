{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "planning_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "readOnly": true
    },
    "project_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "type": {
      "const": "ConversationCommand"
    },
    "conversation_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "client_message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": {
      "const": "direct_user_message"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "description": "The API separately enforces 16 KiB UTF-8 bytes before parsing; character length is not byte enforcement."
    },
    "operation": {
      "enum": [
        "instruction",
        "status",
        "pause",
        "resume",
        "cancel",
        "change_requirements"
      ]
    },
    "workload_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "expected_requirement_revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "proposed_patch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "add",
              "replace",
              "remove"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
      "minItems": 0
    },
    "state": {
      "enum": [
        "planned",
        "received",
        "accepted",
        "needs_clarification",
        "applied",
        "rejected",
        "superseded"
      ]
    },
    "authorisation_context_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ],
      "readOnly": true
    },
    "receipt_event_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effect_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "planning_only",
    "id",
    "revision",
    "tenant_ref",
    "project_ref",
    "type",
    "conversation_ref",
    "client_message_id",
    "source",
    "text",
    "operation",
    "workload_ref",
    "expected_requirement_revision",
    "proposed_patch",
    "state",
    "authorisation_context_ref",
    "receipt_event_ref",
    "effect_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/tip/0.3.0/ConversationCommand.schema.json",
  "title": "ConversationCommand \u2014 proposed planning contract",
  "description": "Planning contract only. Structural validation is not authority, runtime enforcement or measured qualification.",
  "allOf": [
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "planned"
          },
          "authorisation_context_ref": {
            "type": "null"
          },
          "receipt_event_ref": {
            "type": "null"
          },
          "effect_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "accepted",
              "applied"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "planning_only": {
            "const": false
          },
          "authorisation_context_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "receipt_event_ref": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "effect_ref": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "pause",
              "resume",
              "cancel",
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "proposed_patch": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "conversation_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "workload_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}

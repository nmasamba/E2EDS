{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "planning_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "const": "ExecutionRequest"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "readOnly": true
    },
    "project_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "workload_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "compute_binding_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "operation": {
      "enum": [
        "train",
        "evaluate",
        "optimise",
        "simulate",
        "infer",
        "prepare",
        "analyse"
      ]
    },
    "data_access": {
      "enum": [
        "train_tune_only",
        "sealed_evaluator_only",
        "inference_only",
        "permitted_snapshot"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "authorisation_context_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "readOnly": true
    },
    "state": {
      "enum": [
        "planned",
        "admitted",
        "rejected",
        "withdrawn"
      ],
      "readOnly": true
    },
    "admission_expectation": {
      "type": "string",
      "minLength": 1,
      "description": "Planning diagnostic only, never a grant or production policy result."
    },
    "conversation_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "assistant_model_binding_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "source_code_task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "requirement_revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "workflow_plan_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "planning_only",
    "id",
    "revision",
    "type",
    "tenant_ref",
    "project_ref",
    "workload_ref",
    "compute_binding_ref",
    "operation",
    "data_access",
    "idempotency_key",
    "authorisation_context_ref",
    "state",
    "conversation_ref",
    "assistant_model_binding_ref",
    "source_code_task_ref",
    "requirement_revision",
    "workflow_plan_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/tip/0.5.0/ExecutionRequest.schema.json",
  "title": "ExecutionRequest — proposed draft 0.3.0",
  "description": "Planning envelope linking provider-neutral workload intent to one compute binding. Admission comes from trusted policy; no schema annotation is an access-control implementation. Draft 0.3.0 adds conversational/local-assistant and generated-code policy semantics where relevant. Draft 0.5.0 adds bounded preparation/analysis with permitted-snapshot access; no automatic capability qualification.",
  "allOf": [
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "planned"
          },
          "authorisation_context_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "workload_ref": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            }
          },
          "compute_binding_ref": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "not": {
          "required": [
            "admission_expectation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "planning_only": {
            "const": false
          },
          "authorisation_context_ref": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_access": {
            "const": "sealed_evaluator_only"
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "const": "evaluate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "conversation_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "assistant_model_binding_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "source_code_task_ref": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "properties": {
          "workflow_plan_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "prepare",
              "analyse"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data_access": {
            "const": "permitted_snapshot"
          }
        }
      }
    }
  ]
}
